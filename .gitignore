# ============================================================
#  CBT NOVA — PRODUCTION GRADE GITIGNORE CONFIGURATION
# ============================================================

# 1. Credentials & Sensitive Configuration
config/database.php
.env
.env.*
*.key
*.pem
*.crt
*.pfx

# 2. Third-Party Dependencies (Build Artifacts)
/node_modules/
/vendor/

# 3. Database Dumps & Raw Backups (Mencegah Kebocoran Data Siswa)
*.sql
*.sql.gz
*.dump
/backups/*
!/backups/.gitkeep
!/sql/cbt_nova_schema_10k.sql
!/sql/migrate_*.sql
!/sql/sync_*.sql
!/sql/add_*.sql
!/sql/scoring_*.sql
!/sql/performance_*.sql

# 4. User Uploads & Media Storage (Hanya pertahankan struktur folder)
/assets/uploads/foto_siswa/*
!/assets/uploads/foto_siswa/.gitkeep

# 5. Temporary Files, Cache, Logs, & Scratch Area
/scratch/
/writable/
.agents/
*.log
*.bak
*.tmp
*.temp
seed_dummy.php

# 6. Catatan Pengembang Sementara (Internal Notes)
CLAUDE.md
improvement.md
to-do.md

# 7. OS & IDE Metadata
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.suo
*.user
